# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyApp

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Payload CMS & Database
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/sandpiper
PAYLOAD_SECRET=your-payload-secret-at-least-32-characters-long

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Rate limiting — where the real client IP comes from (see docs/blueprint/ARCHITECTURE/04-proxy.md)
# Set to a header your edge OVERWRITES on every request, e.g. cf-connecting-ip (Cloudflare),
# x-vercel-forwarded-for (Vercel), x-real-ip (nginx with proxy_set_header X-Real-IP $remote_addr)
TRUSTED_IP_HEADER=
# Otherwise: number of reverse proxies that append to X-Forwarded-For in front of Next.js
TRUSTED_PROXY_HOPS=1

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyApp

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Payload CMS & Database
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/sandpiper
PAYLOAD_SECRET=your-payload-secret-at-least-32-characters-long

# Media storage in production — MinIO (any S3-compatible store). Leave S3_BUCKET empty locally:
# uploads then go to ./media.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Seeding — `npm run seed` fills an EMPTY site via POST /api/seed (the app must be running);
# `npm run seed:direct` writes straight to DATABASE_URI (use it for production, with S3_*).
# SEED_SECRET (32+ chars) authorizes the script; leave empty to allow only signed-in admins.
SEED_SECRET=
# First admin, created only when the users table is empty
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Rate limiting — where the real client IP comes from (see docs/blueprint/ARCHITECTURE/04-proxy.md)
# Set to a header your edge OVERWRITES on every request, e.g. cf-connecting-ip (Cloudflare),
# x-vercel-forwarded-for (Vercel), x-real-ip (nginx with proxy_set_header X-Real-IP $remote_addr)
TRUSTED_IP_HEADER=
# Otherwise: number of reverse proxies that append to X-Forwarded-For in front of Next.js
TRUSTED_PROXY_HOPS=1
